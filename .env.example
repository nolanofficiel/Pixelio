# Modèle de configuration — copiez ce fichier en « .env » puis ajustez les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# --- MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vault_images

# --- Serveur HTTP ---
# Port d'écoute de l'application
PORT=3000
# 127.0.0.1 = accessible uniquement depuis cette machine
# 0.0.0.0   = accessible depuis le réseau local
HOST=127.0.0.1

# --- Divers ---
# production = cookie de session « Secure » (nécessite HTTPS)
# NODE_ENV=production
